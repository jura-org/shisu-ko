{
  "manifest_version": 3,
  "name": "Shisu-ko",
  "version": "0.14.6",
  "description": "Live Japanese subtitles for YouTube from a local Whisper server, scannable with Yomitan, mined into Anki with screenshot and audio.",
  "homepage_url": "https://github.com/Multysquid/shisu-ko",
  "browser_specific_settings": {
    "gecko": {
      "id": "shisu-ko@multysquid.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "downloads",
    "tabs",
    "notifications"
  ],
  "optional_permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "*://www.youtube.com/*",
    "*://m.youtube.com/*",
    "*://youtube.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "scripts": [
      "browser-api.js",
      "settings.js",
      "match.js",
      "words.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://youtube.com/*"
      ],
      "js": [
        "browser-api.js",
        "settings.js",
        "match.js",
        "words.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Shisu-ko",
    "default_icon": {
      "48": "icons/icon.svg",
      "96": "icons/icon.svg"
    }
  },
  "options_ui": {
    "page": "popup.html"
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "commands": {
    "toggle-subtitles": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Toggle Shisu-ko subtitles"
    },
    "toggle-transcript": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Toggle the transcript panel"
    },
    "mine-current": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Mine the current subtitle: screenshot and audio clip to Anki or Downloads"
    },
    "mark-known": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Mark the word under the pointer as known (or unmark it)"
    },
    "toggle-status": {
      "suggested_key": {
        "default": "Alt+Shift+H"
      },
      "description": "Show or hide the status badge on the video (errors too)"
    }
  }
}
