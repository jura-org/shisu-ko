# Copy to .env and adjust. Used by compose.yaml / compose.cpu.yaml. (.env itself is not committed.)

# Host folder for models, cached audio and cue files. Point it at the native setup's folder to
# share the 3 GB model download:
#   Docker Desktop on Windows:      C:/Users/<you>/.shisu-ko
#   Docker Engine inside WSL:       /mnt/c/Users/<you>/.shisu-ko
#   Linux/macOS:                    /home/<you>/.shisu-ko
DATA_DIR=./data

# Default model: a Kitsune-Transcribe one (Japanese only: kitsune-0.6b, kitsune-0.3b-int8, kitsune-0.1b, ...)
# or a faster-whisper one (large-v3, large-v3-turbo, kotoba-tech/kotoba-whisper-v2.0-faster, small, ...).
# The extension's popup can switch the running container to another one (downloaded into DATA_DIR).
WHISPER_MODEL=large-v3

# Seconds to transcribe ahead of the playhead (0 = whole video)
LOOKAHEAD=900

# CPU variant only
CPU_THREADS=8
